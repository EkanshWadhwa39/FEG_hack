# FEG Hackathon 2026 — Browser Cache Warming
# This project requires no secrets, API keys, or environment variables.
# All configuration is passed via CLI flags to the sandbox server.
#
# Example:
#   python3 tools/sandbox_server.py --bundle /path/to/empireofgold --throttle-kbps 25000
#
# Optional debug flag:
SANDBOX_VERBOSE=0
