# cptr: keep reusable workspace skills, ignore ephemeral chats/task logs
/.cptr/*
!/.cptr/skills/
!/.cptr/skills/**

# Local cptr runtime output (skills above remain shareable)
/cptr.log

# Raw hackathon inputs and evidence (large and/or potentially sensitive)
